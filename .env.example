# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="YOUR_APP_URL"

# Search operations for business discovery
SEARCH_API_KEY="YOUR_SEARCH_API_KEY"

# Telegram Bot for push notifications and reporting
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# Supabase Auth for the Leads & Campaigns Database
SUPABASE_URL="YOUR_SUPABASE_URL"
SUPABASE_KEY="YOUR_SUPABASE_ANON_OR_SERVICE_KEY"

# Gmail Account to send personalized bulk emails
GMAIL_EMAIL="YOUR_GMAIL_ADDRESS"
GMAIL_APP_PASSWORD="YOUR_GMAIL_APP_PASSWORD"

# PageSpeed API for website parsing and audits
PAGESPEED_API_KEY="YOUR_PAGESPEED_API_KEY"
